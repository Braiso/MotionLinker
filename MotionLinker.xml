<?xml version="1.0" encoding="utf-8" ?>
<lc:LibraryCompiler xmlns:lc="urn:abb-robotics-robotstudio-librarycompiler"
										xmlns="urn:abb-robotics-robotstudio-graphiccomponent"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="urn:abb-robotics-robotstudio-librarycompiler file:///C:\Program%20Files%20(x86)\ABB\SDK\RobotStudio%202025%20SDK\LibraryCompilerSchema.xsd
                                        urn:abb-robotics-robotstudio-graphiccomponent file:///C:\Program%20Files%20(x86)\ABB\SDK\RobotStudio%202025%20SDK\GraphicComponentSchema.xsd">
	<lc:Library fileName="MotionLinker.rslib">
		<lc:DocumentProperties>
			<lc:Author>brais.martinez</lc:Author>
			<lc:Image source="MotionLinker.png"/>
		</lc:DocumentProperties>
		<SmartComponent name="MotionLinker" icon="MotionLinker.png"
										codeBehind="MotionLinker.CodeBehind,MotionLinker.dll"
										canBeSimulated="true">
			<Properties>
				
				<DynamicProperty
					name="SourceController"
					valueType="System.String"
					description="Controller source of the movement">
					<Attribute key="AllowedValues" value="?" />
				</DynamicProperty>
				
				<DynamicProperty
					name="OnlineSource"
					valueType="System.Boolean"
					value="false"
					description="True if the source controller is a real controller"/>
				
				<DynamicProperty
					name="TargetController"
					valueType="System.String"
					description="Controller target of the movement">
					<Attribute key="AllowedValues" value="?" />
				</DynamicProperty>
				
				<DynamicProperty
					name="Cartesian"
					valueType="System.Boolean"
					value="false"
					description="Enable Cartesian linking instead of joint linking"/>

				<DynamicProperty
					name="OverwriteWobjdata"
					valueType="System.Boolean"
					value="true"
					description="Overwrite existing work object in the target controller station before synchronization starts"/>

				<DynamicProperty
					name="OverwriteTooldata"
					valueType="System.Boolean"
					value="true"
					description="Overwrite existing tools in the station of target controller station before synchronization starts"/>

				<DynamicProperty
					name="TemporalStationData"
					valueType="System.Boolean"
					value="true"
					description="Remove imported tool and work object data from the RobotStudio station when the simulation stops"/>

			</Properties>
			<Bindings>
			</Bindings>
			<Signals>
			</Signals>
			<GraphicComponents>
			</GraphicComponents>
			<Assets>
				<Asset source="MotionLinker.dll"/>
			</Assets>
		</SmartComponent>
	</lc:Library>
</lc:LibraryCompiler>
